          "step": 1,
          "type": "expect",
          "detail": "The agent notices the drop in ratings and shows it in a chart without being asked."
        },
        {
          "step": 2,
          "type": "message",
          "detail": "Only show the last 12 months on that chart."
        },
        {
          "step": 3,
          "type": "message",
          "detail": "Mark the date the company was sold on the chart."
        },
        {
          "step": 4,
          "type": "action",
          "detail": "Refresh the browser while the chart and report are being written."
        },
        {
          "step": 5,
          "type": "message",
          "detail": "Compare the average rating before and after the sale in a table."
        }
      ]
    },
    {
      "id": "check_4",
      "reviewer_input": "Copperleaf Software",
      "what_this_tests": "Pause and resume during long output, and restarts",
      "follow_ups": [
        {
          "step": 1,
          "type": "expect",
          "detail": "Lots of reviews make for a long piece of streamed output."
        },
        {
          "step": 2,
          "type": "action",
          "detail": "Pause halfway through the agent's output. Restart your backend and worker. Then resume."
        },
