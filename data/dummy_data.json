    {
      "id": "check_1",
      "reviewer_input": "Brightline Logistics",
      "what_this_tests": "The agent asking a single-choice question when the name is ambiguous",
      "follow_ups": [
        {
          "step": 1,
          "type": "expect",
          "detail": "The agent finds three similar names and asks the reviewer to pick one, shown as clickable options."
        },
        {
          "step": 2,
          "type": "answer",
          "detail": "Choose Brightline Logistics Ltd (cmp_001)."
        },
        {
          "step": 3,
          "type": "message",
          "detail": "Show me how their review ratings have changed month by month."
        },
        {
          "step": 4,
          "type": "action",
          "detail": "Pause while the agent is writing the report. Wait a minute, then resume."
        },
        {
          "step": 5,
          "type": "message",
          "detail": "Actually, I meant the Inc one. Redo the check for that company."
        }
      ]
    },
    {
      "id": "check_2",
      "reviewer_input": "Northwind Dental Supplies",
      "what_this_tests": "Feedback on evidence that belongs to a different company",
      "follow_ups": [
        {
          "step": 1,
          "type": "expect",
          "detail": "The agent's concerns may include the lawsuit and the health inspection."
        },
        {
          "step": 2,
          "type": "message",
          "detail": "ev_news_004_02 and ev_news_004_04 are about the dental clinic, not this company. Leave them out."
        },
        {
          "step": 3,
          "type": "expect",
          "detail": "The concerns and report are updated without those articles. Work the feedback didn't affect isn't redone."
        },
        {
          "step": 4,
          "type": "message",
          "detail": "Put the remaining news on a timeline."
        },
        {
          "step": 5,
          "type": "action",
          "detail": "Send the same feedback from step 2 again, twice in a row."
        }
      ]
    },
    {
      "id": "check_3",
      "reviewer_input": "Pinecrest Home Services",
      "what_this_tests": "Visualization tools and feedback on a chart",
      "follow_ups": [
