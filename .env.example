# Copy to .env and fill in. Never commit .env.

# Postgres (docker compose exposes it on 5433)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/company_check

# Temporal (docker compose dev server)
TEMPORAL_ADDRESS=localhost:7233

# LLM — free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.5-flash
# Requests per minute (keep a little under your key's limit; 0 = unlimited)
LLM_RPM=14
LLM_FALLBACK_RPM=4

# Frontend → API
NEXT_PUBLIC_API_URL=http://localhost:8000
